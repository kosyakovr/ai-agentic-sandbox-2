# Shared by docker-compose and apps/api
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
POSTGRES_PORT=5433
DATABASE_URL=postgres://blog:blog@localhost:5433/blog

# apps/api (optional, these are the defaults)
# API_HOST=127.0.0.1
# API_PORT=3001
# LOG_LEVEL=info

# apps/web, server-side only: never prefix these with NEXT_PUBLIC_
API_BASE_URL=http://127.0.0.1:3001
SITE_URL=http://localhost:3000

# API integration tests only: a separate database on the same container, created and migrated by the test helper
TEST_DATABASE_URL=postgres://blog:blog@localhost:5433/blog_test
